{
  "name": "sop_volk",
  "version": "1.0.0",
  "description": "SOP Enterprise",
  "main": "main.js",
  "author": "Eliseu Ramos",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.volk.sop",
    "productName": "SOP Enterprise",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/*",
      "!node_modules/.cache/*",
       "!dados/**",
       "!banco/**"
    ],
    
   "extraResources": [],

    "win": {
      "target": "portable",
      "icon": "icone.ico"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0"
},

"devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
}
}
